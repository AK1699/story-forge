{
  "name": "story-forge",
  "version": "0.1.0",
  "description": "Autonomous visual-story production engine: creative direction through validated final story (Phase 1 scope).",
  "stages": [
    {
      "id": "context-analyzer",
      "command": "/context-analyzer",
      "reads": ["project.json"],
      "writes": ["context/input-analysis.json"],
      "schema": "input-analysis.schema.json"
    },
    {
      "id": "creative-direction",
      "command": "/creative-direction",
      "reads": ["project.json", "context/input-analysis.json"],
      "writes": ["context/creative-direction.json"],
      "schema": "creative-direction.schema.json"
    },
    {
      "id": "concepts",
      "command": "/concepts",
      "reads": ["context/creative-direction.json"],
      "writes": ["story/concepts.json"],
      "schema": "concepts.schema.json"
    },
    {
      "id": "select-concept",
      "command": "/select-concept",
      "reads": ["context/creative-direction.json", "story/concepts.json"],
      "writes": ["story/selected-concept.json"],
      "schema": "selected-concept.schema.json"
    },
    {
      "id": "story-draft",
      "command": "/story-draft",
      "reads": ["context/creative-direction.json", "story/selected-concept.json", "story/concepts.json"],
      "writes": ["story/draft.json"],
      "schema": "story-draft.schema.json"
    },
    {
      "id": "story-critic",
      "command": "/story-critic",
      "reads": ["context/creative-direction.json", "story/draft.json"],
      "writes": ["story/critique.json"],
      "schema": "critique.schema.json"
    },
    {
      "id": "story-rewrite",
      "command": "/story-rewrite",
      "reads": ["context/creative-direction.json", "story/draft.json", "story/critique.json"],
      "writes": ["story/draft.json"],
      "schema": "story-draft.schema.json"
    },
    {
      "id": "entity-bibles",
      "command": "/entity-bibles",
      "reads": ["story/final.json", "context/creative-direction.json"],
      "writes": [
        "context/character-bible.json",
        "context/animal-bible.json",
        "context/object-bible.json",
        "context/location-bible.json"
      ],
      "schema": "character-bible.schema.json",
      "schemas": [
        "character-bible.schema.json",
        "animal-bible.schema.json",
        "object-bible.schema.json",
        "location-bible.schema.json"
      ]
    },
    {
      "id": "visual-bible",
      "command": "/visual-bible",
      "reads": [
        "story/final.json",
        "context/style-preset.json",
        "context/character-bible.json",
        "context/object-bible.json",
        "context/location-bible.json"
      ],
      "writes": ["context/visual-bible.json"],
      "schema": "visual-bible.schema.json"
    },
    {
      "id": "scene-planning",
      "command": "/scene-planning",
      "reads": [
        "story/final.json",
        "context/creative-direction.json",
        "context/character-bible.json",
        "context/animal-bible.json",
        "context/object-bible.json",
        "context/location-bible.json",
        "context/visual-bible.json"
      ],
      "writes": ["scenes/scene-*.json", "context/continuity-state.json"],
      "schema": "scene.schema.json",
      "schemas": ["scene.schema.json", "continuity-state.schema.json"]
    },
    {
      "id": "scene-critic",
      "command": "/scene-critic",
      "reads": [
        "scenes/scene-*.json",
        "context/creative-direction.json",
        "context/character-bible.json",
        "context/animal-bible.json",
        "context/object-bible.json",
        "context/location-bible.json",
        "context/visual-bible.json",
        "context/continuity-state.json",
        "story/final.json"
      ],
      "writes": ["reports/scene-critique.json"],
      "schema": "scene-critique.schema.json"
    },
    {
      "id": "scene-fix",
      "command": "/scene-fix",
      "reads": [
        "reports/scene-critique.json",
        "scenes/scene-*.json",
        "context/continuity-state.json",
        "context/character-bible.json",
        "context/animal-bible.json",
        "context/object-bible.json",
        "context/location-bible.json",
        "context/visual-bible.json"
      ],
      "writes": ["scenes/scene-*.json", "context/continuity-state.json"],
      "schema": "scene.schema.json",
      "schemas": ["scene.schema.json", "continuity-state.schema.json"]
    },
    {
      "id": "image-prompts",
      "command": "/image-prompts",
      "reads": [
        "scenes/scene-*.json",
        "context/visual-bible.json",
        "context/character-bible.json",
        "context/animal-bible.json",
        "context/object-bible.json",
        "context/location-bible.json"
      ],
      "writes": ["prompts/prompt-*.json"],
      "schema": "image-prompt.schema.json"
    }
  ]
}
